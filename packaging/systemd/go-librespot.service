[Unit]
Description=go-librespot Spotify Connect Daemon for Steam Deck
Documentation=https://github.com/devgianlu/go-librespot
After=network.target sound.target

[Service]
Type=simple
Environment=PULSE_RUNTIME_PATH=%t/pulse
Environment=XDG_RUNTIME_DIR=%t
ExecStart=%h/.local/bin/go-librespot -config_path %h/.config/go-librespot/config.yml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
