[Unit]
Description=DeckJam Jukebox Server
Documentation=https://github.com/marcelkornblum/deckjam
After=network.target sound.target pipewire.service pipewire-pulse.service
Wants=go-librespot.service

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=%t
Environment=PIPEWIRE_RUNTIME_DIR=%t
Environment=PULSE_RUNTIME_PATH=%t/pulse
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStartPre=/bin/sh -c 'p="%t/deckjam-audio.fifo"; [ -p "$p" ] || { rm -f "$p"; mkfifo -m 0600 "$p"; }'
ExecStart=%h/.local/bin/deckjam --addr 0.0.0.0:8080 --backend auto --audio-fifo %t/deckjam-audio.fifo
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
