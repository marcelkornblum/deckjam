[Unit]
Description=DeckJam Jukebox Server
Documentation=https://github.com/marcelkornblum/deckjam
After=network.target sound.target go-librespot.service
Wants=go-librespot.service

[Service]
Type=simple
Environment=PULSE_RUNTIME_PATH=%t/pulse
Environment=XDG_RUNTIME_DIR=%t
ExecStart=%h/.local/bin/deckjam --addr 0.0.0.0:8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
