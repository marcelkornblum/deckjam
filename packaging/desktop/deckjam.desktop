[Desktop Entry]
Type=Application
Name=DeckJam Jukebox
GenericName=Party Jukebox
Comment=Self-hosted Spotify party queue for Steam Deck
Exec=/bin/bash -c "if [ -x \"$HOME/.local/share/deckjam/launch-jukebox-ui.sh\" ]; then exec \"$HOME/.local/share/deckjam/launch-jukebox-ui.sh\"; elif [ -x \"$HOME/.local/bin/deckjam-ui\" ]; then exec \"$HOME/.local/bin/deckjam-ui\"; else xdg-open http://127.0.0.1:8080/deck; fi"
Icon=multimedia-player
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=spotify;jam;music;jukebox;party;deck;
StartupNotify=true
